  "qt": "6.10.2",
  "componentFiles": [
    "xips-browser.dll",
    "xips-browser-impl.dll",
    "XipsEla.dll",
    "tools/7zip/7za.exe",
    "xips-capabilities.json",
    "build-info.json",
    "xips-native-runtime.json"
  ],
  "sharedQtModules": [
    "Core",
    "Gui",
    "Widgets",
    "Network",
    "Sql",
    "Xml"

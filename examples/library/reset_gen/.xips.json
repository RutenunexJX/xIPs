{
  "schemaVersion": 1,
  "id": "reset_gen",
  "type": "module",
  "name": "Reset Generator",
  "description": "Synchronizes an active-low asynchronous reset into a target clock domain.",
  "version": "1.2.0",
  "top": "reset_gen",
  "language": "SystemVerilog",
  "sources": [
    "rtl/reset_gen.sv"
  ],
  "includeDirs": [
    "rtl/include"
  ],
  "defines": [
    "XIPS_RESET_STAGES=2"
  ],
  "constraints": [
    "constraints/reset_gen.xdc"
  ],
  "dependencies": [
    {
      "id": "common_types",
      "version": "^1.0.0",
      "optional": true
    }
  ],
  "tests": [
    "tb/reset_gen_tb.sv"
  ],
  "testCommands": [
    {
      "name": "slang-elaboration",
      "program": "slang",
      "arguments": [
        "--top",
        "reset_gen_tb",
        "-I",
        "rtl/include",
        "rtl/reset_gen.sv",
        "tb/reset_gen_tb.sv"
      ],
      "workingDirectory": "."
    }
  ],
  "tools": {
    "slang": ">=6.0",
    "vivado": ">=2022.2"
  },
  "tags": [
    "reset",
    "cdc"
  ],
  "documentation": [
    "README.md"
  ],
  "project": "Utility RTL",
  "favorite": true
}

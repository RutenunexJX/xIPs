{
  "schemaVersion": 1,
  "id": "always_ff_reset",
  "type": "code-block",
  "name": "Always FF Reset",
  "description": "Synchronous register template with an explicit reset branch.",
  "version": "1.0.0",
  "language": "SystemVerilog",
  "scope": [
    "module",
    "begin-end"
  ],
  "template": "always_ff @(posedge ${clk}) begin\n    if (${rst})\n        ${signal} <= ${reset_value};\n    else\n        ${signal} <= ${next_value};\nend",
  "slots": [
    {
      "name": "clk",
      "type": "clock",
      "required": true
    },
    {
      "name": "rst",
      "type": "logic",
      "required": true
    },
    {
      "name": "signal",
      "type": "lvalue",
      "required": true
    },
    {
      "name": "reset_value",
      "type": "expression",
      "required": true
    },
    {
      "name": "next_value",
      "type": "expression",
      "required": true
    }
  ],
  "requiredSymbols": [
    "always_ff"
  ],
  "allowWorkspaceOverride": true,
  "sources": [],
  "includeDirs": [],
  "defines": [],
  "constraints": [],
  "dependencies": [],
  "tests": [],
  "tags": [
    "reset",
    "sequential",
    "template"
  ],
  "project": "Utility RTL",
  "favorite": true,
  "exampleInput": {
    "clk": "clk_i",
    "rst": "rst_i",
    "signal": "count_q",
    "reset_value": "'0",
    "next_value": "count_d"
  },
  "exampleOutput": "always_ff @(posedge clk_i) begin\n    if (rst_i)\n        count_q <= '0;\n    else\n        count_q <= count_d;\nend"
}

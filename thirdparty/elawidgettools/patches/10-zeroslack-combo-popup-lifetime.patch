     d->_themeMode = eTheme->getThemeMode();
     setObjectName("ElaComboBox");
     setFixedHeight(35);
-    d->_comboBoxStyle = new ElaComboBoxStyle(style());
+    d->_comboBoxStyle = new ElaComboBoxStyle(style());

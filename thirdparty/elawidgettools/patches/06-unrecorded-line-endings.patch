+                   << QColor(0x00, 0x0C, 0x7B)
+                   << QColor(0xFF, 0xFE, 0x91)
+                   << QColor(0xFF, 0xFD, 0x55)
+                   << QColor(0xF0, 0x9B, 0x59)
+                   << QColor(0xF0, 0x86, 0x50)

+void ElaPromotionCard::setHorizontalCardPixmapRatio(qreal pixmapRatio)
+{
+    Q_D(ElaPromotionCard);
+    if (pixmapRatio > 0 && pixmapRatio <= 1)
+    {
+        Q_EMIT pHorizontalCardPixmapRatioChanged();
+        d->_pHorizontalCardPixmapRatio = pixmapRatio;
+    }
+}

+    for (auto node: _footerNodeList)
+    {
+        if (node->getNodeKey() == footerKey)
+        {
+            return node;
+        }
+    }
+    return nullptr;
+}
+
+void ElaFooterModel::removeNavigationNode(const QString& footerKey)
+{
+    for (auto node: _footerNodeList)
+    {
+        if (node->getNodeKey() == footerKey)
+        {
+            _footerNodeList.removeOne(node);
+            break;
+        }
+    }
+}

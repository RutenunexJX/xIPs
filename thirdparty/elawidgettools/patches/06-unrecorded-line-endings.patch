+bool ElaKeyBinderContainer::event(QEvent* event)
+{
+    switch (event->type())
+    {
+    case QEvent::KeyPress:
+    {
+        QKeyEvent* keyEvent = dynamic_cast<QKeyEvent*>(event);
+        if (!keyEvent->isAutoRepeat())
+        {
+            switch (keyEvent->key())
+            {
+            case Qt::Key_Shift:
+            {
+                _pBinderKeyText = "Shift";
+                break;
+            }
+            case Qt::Key_Control:
+            {
+                _pBinderKeyText = "Ctrl";
+                break;

+    painter->drawRoundedRect(QRectF(foregroundRect.x(), foregroundRect.bottom() - _timePercentHeight, foregroundRect.width() * _pTimePercent / 100.0, _timePercentHeight + 1), 2, 2);
+    painter->restore();
+    // 文字颜色
+    painter->setPen(Qt::black);
+}

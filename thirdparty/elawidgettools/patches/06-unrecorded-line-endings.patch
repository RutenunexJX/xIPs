+            case Qt::Key_Meta:
+            {
+                _pBinderKeyText = "Win";
+                break;
+            }
+            default:
+            {
+                _pBinderKeyText = QKeySequence(keyEvent->key()).toString();
+                break;
+            }
+            }
+            _pNativeVirtualBinderKey = keyEvent->nativeVirtualKey();
+            update();
+        }
+        event->accept();
+        return true;
+    }
+    default:
+    {
+        break;
+    }
+    }
+    return QWidget::event(event);
+}

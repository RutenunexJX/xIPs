+void ElaNavigationView::mouseDoubleClickEvent(QMouseEvent* event)
+{
+    _navigationStyle->setPressIndex(indexAt(event->pos()));
+    viewport()->update();
+    QTreeView::mouseDoubleClickEvent(event);
+}

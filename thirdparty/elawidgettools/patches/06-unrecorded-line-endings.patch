-bool ElaMessageBarPrivate::_judgeCreateOrder(ElaMessageBar* otherMessageBar)
-{
-    if (otherMessageBar->d_ptr->_createTime < _createTime)
-    {
-        //otherMessageBar先创建
-        return true;
-    }
-    else
-    {
-        return false;
-    }
-}

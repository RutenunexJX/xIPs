+void ElaAppBarPrivate::_changeMaxButtonAwesome(bool isMaximized)
+{
+    if (isMaximized)
+    {
+        _maxButton->setElaIcon(ElaIconType::WindowRestore);
+    }
+    else
+    {
+        _maxButton->setElaIcon(ElaIconType::Square);
+    }
+}

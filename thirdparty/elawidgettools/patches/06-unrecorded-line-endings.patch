+    ElaScrollBar* hScrollBar = new ElaScrollBar(this);
+    hScrollBar->setIsAnimation(true);
+    connect(hScrollBar, &ElaScrollBar::rangeAnimationFinished, this, [=]() {
+        doItemsLayout();

+bool ElaPopularCard::event(QEvent* event)
+{
+    Q_D(ElaPopularCard);
+    switch (event->type())
+    {
+    case QEvent::Enter:
+    {
+        d->_floatTimer->start(450);
+        QPropertyAnimation* hoverAnimation = new QPropertyAnimation(d, "pHoverYOffset");
+        connect(hoverAnimation, &QPropertyAnimation::valueChanged, this, [=]() {
+            update();

+void ElaComboBox::mousePressEvent(QMouseEvent* event)
+{
+    if (event->button() == Qt::LeftButton && !isEditable() && view()->isVisible()) {
+        hidePopup();
+        event->accept();
+        return;
+    }
+    QComboBox::mousePressEvent(event);
+}
